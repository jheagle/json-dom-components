{
  "name": "treeloom-components",
  "description": "A minimal component library on treeloom: base HTML element factories plus richer interactive components.",
  "version": "0.1.0",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "author": "Joshua Heagle",
  "license": "MPL-2.0",
  "keywords": [
    "components",
    "treeloom",
    "typeahead",
    "dom",
    "ui",
    "typescript"
  ],
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "js-build-tools": "^8.2.0",
    "treeloom": "^2.0.0",
    "release-it": "^21.1.1",
    "test-filesystem": "^2.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "si-funciona": "^2.10.0"
  },
  "peerDependencies": {
    "treeloom": "^2.0.0"
  },
  "files": [
    "dist",
    "browser",
    "styles"
  ],
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/treeloom-components.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/treeloom-components/issues"
  },
  "homepage": "https://github.com/jheagle/treeloom-components#readme",
  "standard": {
    "env": [
      "jest"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
